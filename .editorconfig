root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,xml}]
indent_style = space
indent_size = 2

[*.{yml,yaml,sh}]
end_of_line = lf

[*.ps1]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
